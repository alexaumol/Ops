# Ops instance — {{SLUG}} ({{DISPLAY_NAME}})
# Rendered by provision/provision.js -> /etc/nginx/sites-available/ops-{{SLUG}}.conf
# TLS from the shared *.ops.theaumol.com wildcard (0E). The static frontend
# is the shared /opt/ops/public tree; only /js/config.js is per-instance.

server {
    listen 443 ssl http2;
    server_name {{DOMAIN}};

    ssl_certificate     {{TLS_CERT}};
    ssl_certificate_key {{TLS_KEY}};

    root {{CODE_DIR}}/public;
    index index.html;

    # Per-instance runtime config overrides the shared file.
    location = /js/config.js {
        alias {{INSTANCE_DIR}}/config.js;
        add_header Cache-Control "no-store";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        client_max_body_size 20m;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    server_name {{DOMAIN}};
    return 301 https://$host$request_uri;
}

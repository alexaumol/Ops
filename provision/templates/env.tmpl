# Ops instance env — {{SLUG}} ({{DISPLAY_NAME}})
# Rendered by provision/provision.js. Do not edit by hand; re-provision or
# edit the template. Referenced by the ops@{{SLUG}} systemd unit via
# OPS_ENV_FILE.

PGHOST={{PGHOST}}
PGPORT={{PGPORT}}
PGDATABASE={{DB_NAME}}
PGUSER={{DB_ROLE}}
PGPASSWORD={{DB_PASSWORD}}
PGSSLMODE={{PGSSLMODE}}

PORT={{PORT}}
NODE_ENV=production

UPLOAD_DIR={{INSTANCE_DIR}}/uploads

CORS_ALLOWED_ORIGINS=https://{{DOMAIN}}

AUTH_MODE=bearer

# Identity — the shared broker (Zitadel). See docs/migrations.md / 0A.
OIDC_ISSUER={{OIDC_ISSUER}}
OIDC_AUDIENCE={{OIDC_AUDIENCE}}

# Outbound mail + Graph + Azure OpenAI are configured per instance after
# provisioning if the customer needs them — see server/.env.example.

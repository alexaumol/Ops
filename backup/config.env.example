# Ops backup config — copy to backup/config.env (gitignored) and fill in.
#   sudo install -m 600 backup/config.env.example /etc/ops/backup.env
# and point the timer at it with OPS_BACKUP_CONFIG=/etc/ops/backup.env.
#
# No secrets live here. Postgres auth comes from ~/.pgpass (root's, chmod 600);
# object-storage auth comes from the rclone remote (~/.config/rclone/rclone.conf).

# Space-separated host:port list of local Postgres clusters to dump.
#   Ops VPS:  "127.0.0.1:5432"                 (Zitadel + every ops_<slug> silo)
#   HITT VPS: "127.0.0.1:5432 127.0.0.1:8432"  (if test_ops is a second cluster)
PG_CLUSTERS="127.0.0.1:5432"

# Superuser to connect as. Needs a matching ~/.pgpass line per cluster:
#   127.0.0.1:5432:*:postgres:<password>
PG_SUPERUSER="postgres"

# Databases to skip (space-separated, exact names). Templates and `postgres`
# are always skipped. Leave empty to back up everything.
EXCLUDE_DBS=""

# Where dumps land before upload, and how long they stay.
LOCAL_DIR="/var/backups/ops"
LOCAL_KEEP_DAYS="7"

# rclone remote + bucket/prefix. Empty = local-only (a loud warning; don't
# ship to prod like that). Use a `crypt` remote wrapping the S3 remote so
# dumps are client-side encrypted before they leave the box — see docs/backups.md.
#   IONOS Object Storage example remote name: ionos-crypt
RCLONE_REMOTE="ionos-crypt:ops-backups"
REMOTE_KEEP_DAYS="31"

# Label for this host in paths / logs. Defaults to `hostname -s`.
# Set it explicitly per box — both VPSes hostname to something generic and
# would collide in the bucket.
HOSTLABEL="ops-vps"

# On-disk file dirs to mirror alongside the DB dumps (expense evidence, etc.).
# Space-separated. Synced (not versioned) to <remote>/<host>/files/<basename>/.
#   Ops VPS silos:  "/srv/ops/demo/uploads /srv/ops/acme/uploads"  (or a glob you expand)
#   HITT VPS:       "/opt/hitt-ops/server/uploads"
UPLOAD_DIRS=""

# Dead-man's-switch. healthchecks.io (or self-hosted / Uptime Kuma push URL).
# Pinged <url>/start on start, <url> on success, <url>/fail on failure.
# If backups stop running, the check goes red on its own — silence = alarm.
# HEALTHCHECK_URL="https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

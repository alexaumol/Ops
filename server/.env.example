# -----------------------------------------------------------------------
# HITT Ops API — environment configuration
#
# Copy this file to ".env" on the SERVER ONLY. Never commit the real .env,
# never copy it into /public, and never send it to employee machines —
# this is precisely the file that keeps DB credentials out of everyone's
# hands except the server process itself.
#
#   cp .env.example .env   # then edit .env with real values
#
# .env is already covered by server/.gitignore.
# -----------------------------------------------------------------------

# --- PostgreSQL test environment ---
# NOTE: keep comments on their own line, never trailing on the same line as
# a value — dotenv does not strip trailing "#" comments, so a trailing
# comment silently becomes PART of the value (bit us in production
# 2026-08-27: a trailing comment on PGDATABASE below made every DB query
# fail with "database ... does not exist").
PGHOST=217.154.101.149
PGPORT=8432
# confirmed 2026-08-25: "ops" is the live/production DB, do not point there
PGDATABASE=test_ops
PGUSER=postgres
PGPASSWORD=REPLACE_ME
# set to "require" once the test box has TLS
PGSSLMODE=disable

# --- API server ---
PORT=4000
NODE_ENV=production

# Where expense evidence files (images / PDFs) are written. Optional —
# defaults to server/uploads/. Files land in <UPLOAD_DIR>/expenses/.
# UPLOAD_DIR=/var/lib/hitt-ops/uploads

# --- CORS: comma-separated list of origins allowed to call this API.
# When the frontend runs from file:// (a local copy) the browser sends
# "Origin: null" — include it only while prototyping, remove for real use.
CORS_ALLOWED_ORIGINS=https://ops.fhitt.org,http://localhost:5500,null

# --- Microsoft Entra ID (for later real auth validation) ---
AAD_TENANT_ID=REPLACE_WITH_TENANT_ID
AAD_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID

# --- Microsoft Graph (OneDrive project-folder creation, see lib/graph.js) ---
# A SEPARATE app registration from AAD_CLIENT_ID above (confidential/daemon
# app, Sites.Selected Application permission, granted just against the one
# OneDrive account below) — not the public SPA client employees sign in
# with. All five required for the feature to run; missing any of them just
# skips folder creation silently rather than failing project creation.
GRAPH_TENANT_ID=REPLACE_WITH_TENANT_ID
GRAPH_CLIENT_ID=REPLACE_WITH_GRAPH_APP_CLIENT_ID
GRAPH_CLIENT_SECRET=REPLACE_ME
GRAPH_ONEDRIVE_USER=REPLACE_WITH_UPN
GRAPH_ONEDRIVE_FOLDER=REPLACE_WITH_FOLDER_PATH

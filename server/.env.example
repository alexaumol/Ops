# -----------------------------------------------------------------------
# Ops API — environment configuration TEMPLATE
#
# Copy this file to ".env" on the SERVER ONLY, one per instance. Never
# commit the real .env, never copy it into /public, never send it to an
# employee machine — this is the file that keeps DB credentials out of
# everyone's hands except the server process itself.
#
#   cp .env.example .env   # then edit .env with this instance's values
#
# .env is covered by server/.gitignore. Values marked [per-instance] differ
# for every customer; the provisioning script renders them.
#
# NOTE: keep comments on their own line, never trailing on a value line —
# dotenv does not strip a trailing "#", so it becomes part of the value.
# -----------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------
# [per-instance] one database + one role scoped to it (no shared superuser).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ops_CUSTOMER
PGUSER=ops_CUSTOMER
PGPASSWORD=REPLACE_ME
# "require" once the DB has TLS; "disable" for a local same-host socket.
PGSSLMODE=disable

# --- API server ------------------------------------------------------
PORT=4000
NODE_ENV=production

# Where uploaded evidence files (expense documents, …) are written.
# [per-instance] keep each instance's uploads separate. Files land in
# <UPLOAD_DIR>/expenses/. Defaults to server/uploads/ if unset.
UPLOAD_DIR=/srv/ops/CUSTOMER/uploads

# --- CORS ------------------------------------------------------------
# [per-instance] this instance's own frontend origin. One value — no
# localhost, no "null" (that's dev-only, it lets file:// pages call the API).
CORS_ALLOWED_ORIGINS=https://CUSTOMER.ops.theaumol.com

# --- Authentication mode -------------------------------------------
#   bearer  every request must carry a valid, signature-verified access
#           token (Authorization: Bearer <jwt>). Recommended for any real
#           deployment. Default when the OIDC/AAD vars below are set.
#   hybrid  a valid token wins; otherwise fall back to the X-HITT-User
#           header. Rollout only.
#   header  legacy — trust the client header. NOT secure. Local/offline only.
AUTH_MODE=bearer

# --- Identity: OIDC (server/lib/oidcToken.js) -----------------------
# When set, the API also accepts access tokens from this issuer — the
# shared broker (Zitadel at auth.theaumol.com) for SaaS instances, or a
# customer's own IdP for a self-hosted one. Runs alongside the Entra block
# below (a request's token is routed by its `iss`), so a cutover needs no
# flag day: set these, flip the frontend, roll back by unsetting them.
# The token must be a JWT (in Zitadel: app -> Token Settings -> Auth Token
# Type = JWT), not an opaque token.
# OIDC_ISSUER=https://auth.theaumol.com
# OIDC_AUDIENCE is comma-separated: the app's client id, and optionally its
# Zitadel project id (Zitadel puts the project id in `aud`, client id in `azp`).
# OIDC_AUDIENCE=REPLACE_WITH_OPS_CLIENT_ID

# --- Identity: Microsoft Entra ID ----------------------------------
# Same tenant + SPA app registration the frontend signs in with
# (public/js/config.js MSAL block). For AUTH_MODE=bearer, on that app:
#   1. Expose an API  ->  Application ID URI  api://<AAD_CLIENT_ID>
#   2. Add a scope    ->  access_as_user  (admin + user consent)
#   3. Authorized client applications -> add <AAD_CLIENT_ID>, pre-authorize
AAD_TENANT_ID=REPLACE_WITH_TENANT_ID
AAD_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
# AAD_ALLOWED_AUDIENCES=api://<AAD_CLIENT_ID>,<AAD_CLIENT_ID>
# AAD_REQUIRED_SCOPE=access_as_user

# --- Ops assistant: Azure OpenAI (lib/chatLlm.js, routes/chat.js) ----
# EU region (Sweden Central / France Central / …), model in the GPT-5 family
# (gpt-4.1 is legacy). Missing any of the first three => /api/chat returns
# 503 (feature simply off).
#
# ENDPOINT: use the resource's "v1" endpoint — it ends in /openai/v1 (see
#   the resource's Overview / "Endpoints" panel). A classic host (no path)
#   also works; the client falls back to the deployments path.
# DEPLOYMENT: the deployment NAME you gave the model, not the model id.
# API_VERSION: leave unset for the v1 endpoint unless a preview feature needs it.
# REASONING_EFFORT: minimal | low | medium | high — GPT-5 tradeoff of speed
#   vs depth. "low" is a good default for a tool-calling assistant.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=REPLACE_ME
# AZURE_OPENAI_DEPLOYMENT=ops-gpt-5-mini
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_REASONING_EFFORT=low
# AZURE_OPENAI_MAX_TOKENS=1400
# AZURE_OPENAI_VERBOSITY=            # low | medium | high; blank = model default
# AZURE_OPENAI_AUTH_STYLE=api-key    # or "bearer" if a v1 endpoint rejects api-key
#
# Verify wiring (no DB needed):  npm run chat:smoke

# --- Ops assistant: read-only database role -------------------------
# The assistant runs every query on this SELECT-only role. If unset it
# falls back to the main pool (fine for a first test, NOT for production):
#   CREATE ROLE ops_readonly LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE <PGDATABASE> TO ops_readonly;
#   GRANT USAGE ON SCHEMA public TO ops_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO ops_readonly;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO ops_readonly;
# PG_READONLY_HOST / _PORT / _DATABASE default to the PG* values above.
# PG_READONLY_USER=ops_readonly
# PG_READONLY_PASSWORD=REPLACE_ME
# PG_READONLY_TIMEOUT_MS=8000

# --- Microsoft Graph: OneDrive project-folder creation (lib/graph.js) -
# A confidential/daemon app (Sites.Selected) — separate from the sign-in
# client. All five required; missing any just skips folder creation.
# GRAPH_TENANT_ID=REPLACE_WITH_TENANT_ID
# GRAPH_CLIENT_ID=REPLACE_WITH_GRAPH_APP_CLIENT_ID
# GRAPH_CLIENT_SECRET=REPLACE_ME
# GRAPH_ONEDRIVE_USER=REPLACE_WITH_UPN
# GRAPH_ONEDRIVE_FOLDER=REPLACE_WITH_FOLDER_PATH

# --- Outbound email: invoice "Email invoice" action ------------------
# The From mailbox and transport per billing entity are set in the app
# (Settings -> Entities -> "Invoice email"): mailtransport = graph | smtp,
# mailsender = the From address. These env vars only configure the two
# transports and the last-resort default sender.
#
# Graph transport — confidential app with Mail.Send (admin-consented),
# ideally scoped by an application access policy to the sender mailbox:
# GRAPH_MAIL_TENANT_ID=REPLACE_WITH_TENANT_ID
# GRAPH_MAIL_CLIENT_ID=REPLACE_WITH_MAIL_APP_CLIENT_ID
# GRAPH_MAIL_CLIENT_SECRET=REPLACE_ME
#
# SMTP transport — for a sender mailbox that isn't in the M365 tenant:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=invoices@company.com
# SMTP_PASS=REPLACE_ME
# SMTP_SECURE=true                # implicit TLS; auto-true when SMTP_PORT=465
# SMTP_FROM=invoices@company.com  # defaults to SMTP_USER
#
# Last-resort From address when an entity has no mailsender and no invoicing
# email set:
# GRAPH_MAIL_SENDER=invoices@company.com

# --- Veri*Factu: Spain e-invoicing compliance (server/lib/verifactu/) ---
# Bridges Ops invoicing to the AEAT via BOLD Software's API as the SIF, so
# Ops itself is not certified. Leave the feature OFF for any non-Spanish
# instance — the DB columns are inert and nothing calls the provider.
# Full plan: docs/verifactu-integration-roadmap.md
#
# FEATURE_VERIFACTU=false            # "true" enables everything in the module
# VERIFACTU_PROVIDER=bold            # the only adapter today
# VERIFACTU_ENV=sandbox             # sandbox | production — fallback when an
#                                    # entity has no verifactu_environment set
# VERIFACTU_BASE_URL=https://vf1.boldsoftware.es/v1   # override for testing
# VERIFACTU_VERIFY_ISSUER=           # blank: send the Verify-Issuer-Id guard
#                                    # only in production. "false" never sends
#                                    # it (use if the entity NIF differs from
#                                    # the API-Key's, e.g. a shared sandbox
#                                    # company). "true" always sends it.
#
# The per-entity API keys are NOT here — one BOLD API-Key per issuing NIF
# (conservative assumption; BOLD to confirm), stored on entity.verifactu_api_key
# via Settings -> Entities -> Veri*Factu, server-side only.
#
# For the sandbox smoke test (npm run verifactu:smoke):
# VERIFACTU_API_KEY=sk_sandbox_xxx
# VERIFACTU_ISSUER_NIF=B13674197

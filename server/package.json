{
  "name": "hitt-ops-api",
  "version": "0.1.0",
  "private": true,
  "description": "HITT Ops backend API — the only component that holds PostgreSQL credentials. Serves the static frontend in /public over authenticated HTTPS calls.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:create": "node-pg-migrate create -m migrations --migration-file-language sql --",
    "secrets:test": "node --test scripts/secrets.test.js",
    "presence:verify": "node scripts/presence-verify.js",
    "presence:purge": "node scripts/presence-purge.js",
    "sync:external": "node scripts/sync-external.js",
    "verifactu:test": "node --test scripts/verifactu-mapping.test.js scripts/verifactu-issue.test.js",
    "verifactu:smoke": "node scripts/verifactu-smoke.js",
    "verifactu:poll": "node scripts/verifactu-poll.js",
    "chat:smoke": "node scripts/chat-smoke.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jose": "^5.10.0",
    "multer": "^2.2.0",
    "node-pg-migrate": "^7.9.1",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "pg": "^8.12.0"
  },
  "overrides": {
    "glob": "^11.0.4",
    "qs": "^6.16.0"
  }
}

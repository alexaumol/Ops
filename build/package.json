{
  "name": "hitt-ops-frontend-build",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only tooling. Tailwind CSS build for public/pages/projects.html, and the source of the vendored MSAL browser library. Both produce static output committed under public/ — nothing here ships to employees or runs at runtime.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src.css -o ../public/css/projects-tailwind.css --minify",
    "vendor:msal": "node -e \"require('fs').copyFileSync('node_modules/@azure/msal-browser/lib/msal-browser.min.js', '../public/vendor/msal-browser.min.js')\"",
    "vendor:oidc": "node -e \"require('fs').copyFileSync('node_modules/oidc-client-ts/dist/browser/oidc-client-ts.min.js', '../public/vendor/oidc-client-ts.min.js')\"",
    "vendor:html2canvas": "node -e \"require('fs').copyFileSync('node_modules/html2canvas/dist/html2canvas.min.js', '../public/vendor/html2canvas.min.js')\""
  },
  "devDependencies": {
    "@azure/msal-browser": "^5.19.0",
    "html2canvas": "^1.4.1",
    "oidc-client-ts": "^3.5.0",
    "tailwindcss": "^3.4.13"
  }
}
